# Puerto del servidor
PORT=3000

# MongoDB URI
# Para MongoDB Atlas (nube): mongodb+srv://usuario:password@cluster.mongodb.net/bibliosmart
# Para MongoDB local: mongodb://localhost:27017/bibliosmart
MONGODB_URI=mongodb://localhost:27017/bibliosmart

# Entorno
NODE_ENV=development

# Google Gemini API Key
# Obtén tu API key en: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here
